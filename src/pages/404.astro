---
import Page from '../layouts/Page.astro';
import { dict, path } from '../i18n';
const d = dict('es');
---
<Page title={`404 · ${d.meta.siteName}`} noindex alternate="/en/">
  <section class="wrap nf">
    <h1 class="display" style="font-size: var(--fs-section)">{d.common.notFoundTitle}</h1>
    <p class="lead">{d.common.notFoundText}</p>
    <a class="label link-rule" href={path('home', 'es')}>{d.common.backHome}</a>
  </section>
</Page>
<style>
  .nf { min-height: 60vh; display: flex; flex-direction: column; justify-content: center; gap: 1.5rem; align-items: flex-start; padding-block: var(--section-y); }
</style>
