---
/**
 * Layout base de toda la web.
 * Se encarga de: <html lang>, metadatos SEO (title, description, canonical, hreflang, OG/Twitter),
 * datos estructurados JSON-LD, fuentes autoalojadas, estilos globales, aviso de cookies y "saltar al contenido".
 * Las páginas añaden bloques JSON-LD con `schema` y migas de pan con `crumbs`.
 */
import { Font } from 'astro:assets';
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { resolveLocale, htmlLang, alternatePath, dict, path, type Locale } from '../i18n';
import { site } from '../data/site';
import { baseGraph, breadcrumbs } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  /** Imagen OG absoluta o relativa a /. Por defecto la del sitio. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Evita indexación (legales en borrador, 404, gracias). */
  noindex?: boolean;
  /** Ruta equivalente en el otro idioma; si no se pasa, se deduce del mapa de rutas. */
  alternate?: string;
  bodyClass?: string;
  /** Bloques JSON-LD adicionales de la página. */
  schema?: Record<string, unknown>[];
  /** Migas de pan (sin la home; se añade sola). */
  crumbs?: { name: string; href: string }[];
}

const locale: Locale = resolveLocale(Astro.currentLocale);
const other: Locale = locale === 'es' ? 'en' : 'es';
const d = dict(locale);

const {
  title = d.meta.defaultTitle,
  description = d.meta.defaultDescription,
  ogImage = site.ogImage,
  ogType = 'website',
  noindex = false,
  alternate,
  bodyClass = '',
  schema = [],
  crumbs,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, siteUrl).href;
const alternateHref = new URL(alternate ?? alternatePath(pathname, locale, other), siteUrl).href;
const esHref = locale === 'es' ? canonical : alternateHref;
const enHref = locale === 'en' ? canonical : alternateHref;
const ogImageAbs = new URL(ogImage, siteUrl).href;

const graph = [
  ...baseGraph(locale),
  ...(crumbs ? [breadcrumbs([{ name: d.breadcrumb.home, href: path('home', locale) }, ...crumbs])] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const gaId = import.meta.env.PUBLIC_GA4_ID as string | undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="alternate" hreflang="es-ES" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />

    <meta property="og:site_name" content={d.meta.siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_GB' : 'es_ES'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <meta name="theme-color" content="#f4f4f1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-display" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-text" preload={[{ subset: "latin", weight: 400 }, { subset: "latin", weight: 700 }]} />

    <script type="application/ld+json" set:html={jsonLd} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link label" href="#main">{d.nav.skip}</a>
    <slot />
    {gaId && <CookieBanner gaId={gaId} />}
  </body>
</html>
