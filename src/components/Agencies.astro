---
/** Bloque "Para agencias": titular, tres promesas y CTA. */
import PromiseRow from './PromiseRow.astro';
import { resolveLocale, dict, path } from '../i18n';
const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const promises = [
  { title: d.agencies.p1t, text: d.agencies.p1 },
  { title: d.agencies.p2t, text: d.agencies.p2 },
  { title: d.agencies.p3t, text: d.agencies.p3 },
];
---
<section class="agencies on-dark" aria-labelledby="agencies-title">
  <div class="agencies__inner wrap grid-12">
    <div class="agencies__head">
      <p class="label accent">{d.agencies.kicker}</p>
      <h2 id="agencies-title" class="display agencies__title">{d.agencies.title}</h2>
    </div>
    <div class="agencies__body">
      <ul class="promises" role="list">
        {promises.map((p) => <PromiseRow title={p.title} text={p.text} />)}
      </ul>
      <a class="btn btn--accent label agencies__cta" href={path('contact', locale)}>{d.common.cta}</a>
    </div>
  </div>
</section>

<style>
  .agencies { margin-top: var(--section-y-lg); padding-block: 2.75rem 3rem; }
  .agencies__inner { row-gap: 1.25rem; }
  .agencies__head, .agencies__body { grid-column: 1 / -1; }
  .agencies__head { display: flex; flex-direction: column; gap: 1rem; }
  .agencies__title { font-size: var(--fs-block); line-height: 0.9; }
  .agencies__body { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 0.5rem; }
  .agencies__cta { height: 56px; }

  @media (min-width: 900px) {
    .agencies { padding-block: 4.5rem 5rem; }
    .agencies__head { grid-column: 1 / span 6; }
    .agencies__title { white-space: pre-line; }
    .agencies__body { grid-column: 7 / span 6; margin-top: 0; gap: 2rem; }
    .agencies__cta { align-self: flex-start; height: auto; padding: 1.25rem 1.75rem; }
  }
</style>
