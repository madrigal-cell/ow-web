---
/**
 * Vídeo de Vimeo embebido en la propia web (nunca se envía al usuario a Vimeo).
 * Fachada: no carga nada de Vimeo hasta que el usuario pulsa play.
 * Los vídeos no listados de Vimeo necesitan además su `vimeoHash`.
 * Sin vimeoId muestra un hueco del color indicado con el aviso de pendiente.
 */
import { Image } from 'astro:assets';
import { resolveLocale, dict } from '../i18n';
interface Props { vimeoId?: string; vimeoHash?: string; title: string; tone?: 'accent' | 'ink' | 'paper'; label?: string; poster?: ImageMetadata; posterAlt?: string }
const { vimeoId, vimeoHash, title, tone = 'ink', label, poster, posterAlt = '' } = Astro.props;
const d = dict(resolveLocale(Astro.currentLocale));
---
<div class:list={['vimeo', `vimeo--${tone}`, { 'vimeo--poster': !!poster }]} data-vimeo-id={vimeoId} data-vimeo-hash={vimeoHash}>
  {poster && <Image class="vimeo__poster" src={poster} alt={posterAlt} widths={[640, 1024, 1600]} sizes="(min-width: 1600px) 1500px, 100vw" loading="eager" fetchpriority="high" />}
  {vimeoId ? (
    <button class="vimeo__play" type="button" aria-label={`${d.showreel.play}: ${title}`}>
      <span class="vimeo__btn"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 4.5v15l12-7.5-12-7.5z" fill="currentColor"/></svg></span>
      {label && <span class="label vimeo__label">{label}</span>}
    </button>
  ) : (
    <p class="label vimeo__pending">{d.casePage.videoPending}</p>
  )}
  <div class="vimeo__player" hidden></div>
</div>

<style>
  .vimeo { position: relative; aspect-ratio: 16 / 9; overflow: hidden; display: flex; align-items: flex-end; padding: 1rem; }
  .vimeo--accent { background: var(--color-accent); color: var(--color-ink); }
  .vimeo--ink { background: var(--color-ink); color: var(--color-bg); background-image: repeating-linear-gradient(135deg, var(--color-ink) 0 40px, var(--color-stripe-dark) 40px 80px); }
  .vimeo--paper { background: var(--color-placeholder); color: var(--color-ink); }
  .vimeo__play { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: space-between; padding: 1.5rem; color: inherit; text-align: left; }
  .vimeo__btn { width: 96px; height: 96px; background: var(--color-accent); color: var(--color-ink); display: grid; place-items: center; transition: transform var(--dur) var(--ease), background var(--dur) var(--ease); }
  .vimeo--accent .vimeo__btn { background: var(--color-ink); color: var(--color-bg); }
  .vimeo__play:hover .vimeo__btn { transform: scale(1.04); }
  .vimeo__pending { position: relative; opacity: 0.8; }
  .vimeo :global(.vimeo__poster) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vimeo--poster .vimeo__play { color: var(--color-bg); background: linear-gradient(to top, rgba(11, 11, 11, 0.55), transparent 45%); }
  .vimeo--poster .vimeo__btn { background: var(--color-accent); color: var(--color-ink); }
  .vimeo__player { position: absolute; inset: 0; background: #000; }
  .vimeo__player :global(iframe) { width: 100%; height: 100%; border: 0; }
  @media (min-width: 900px) { .vimeo { padding: 1.5rem; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.vimeo[data-vimeo-id]').forEach((box) => {
    const id = box.dataset.vimeoId;
    const hash = box.dataset.vimeoHash;
    const btn = box.querySelector<HTMLButtonElement>('.vimeo__play');
    const player = box.querySelector<HTMLElement>('.vimeo__player');
    if (!id || !btn || !player) return;
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://player.vimeo.com/video/${id}?autoplay=1&title=0&byline=0&portrait=0&dnt=1${hash ? `&h=${hash}` : ``}`;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.title = btn.getAttribute('aria-label') ?? 'Vimeo';
      player.replaceChildren(iframe);
      player.hidden = false;
      btn.hidden = true;
    }, { once: true });
  });
</script>
