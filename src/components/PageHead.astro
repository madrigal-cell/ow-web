---
/** Cabecera de página interior: kicker, titular gigante y entradilla. */
interface Props { kicker?: string; title: string; lead?: string; size?: 'section' | 'block'; preLine?: boolean }
const { kicker, title, lead, size = 'section', preLine = false } = Astro.props;
---
<header class="page-head wrap grid-12">
  <div class="page-head__main">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1 class:list={['display', 'page-head__title', `page-head__title--${size}`, { 'pre-line': preLine }]}>{title}</h1>
  </div>
  {lead && <p class="lead page-head__lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-head { padding-block: 2rem 1.5rem; row-gap: 1.25rem; align-items: end; }
  .page-head__main { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 1rem; }
  .page-head__title--section { font-size: var(--fs-section); line-height: 0.9; }
  .page-head__title--block { font-size: var(--fs-block); line-height: 0.9; }
  .page-head__lead { grid-column: 1 / -1; max-width: 40ch; }
  @media (min-width: 900px) {
    .page-head { padding-block: 3.5rem 2.5rem; }
    .page-head__main { grid-column: 1 / span 8; }
    .page-head__lead { grid-column: 9 / span 4; padding-bottom: 0.5rem; }
    .pre-line { white-space: pre-line; }
  }
</style>
