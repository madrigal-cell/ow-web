---
// Componente temporal del paso 1. Se elimina cuando exista la Home real.
import { resolveLocale, useTranslations, path } from '../i18n';
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---
<main id="main" class="wrap placeholder">
  <p class="label muted">{locale.toUpperCase()} · {t('nav.currentLangShort')} — <a class="link-rule" href={path('home', locale === 'es' ? 'en' : 'es')}>{t('nav.switchLang')}</a></p>
  <h1 class="display hero-brand">{t('hero.brand')}</h1>
  <p class="display hero-claim accent">{t('hero.claim')}</p>
  <p class="lead hero-sub">{t('hero.sub')}</p>
  <p class="label" style="color: var(--color-label)">{t('hero.services')}</p>
  <a class="btn label" href="#" style="margin-top: 2rem">{t('common.cta')}</a>
</main>

<style>
  .placeholder { padding-block: var(--section-y); display: flex; flex-direction: column; gap: 1.25rem; min-height: 100vh; }
  .hero-brand { font-size: var(--fs-hero); line-height: 0.86; }
  .hero-claim { font-size: var(--fs-claim); line-height: 0.92; max-width: 12ch; }
  .hero-sub { max-width: 34ch; }
  .btn { align-self: flex-start; }
</style>
