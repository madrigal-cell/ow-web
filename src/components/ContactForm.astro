---
/**
 * Formulario de contacto (corto) o de brief (largo). Envía por POST al script PHP de IONOS (paso 4).
 * Incluye honeypot ("website") y campo de idioma para responder en el idioma del visitante.
 */
import { resolveLocale, dict, path } from '../i18n';
interface Props { variant?: 'contact' | 'brief'; id?: string }
const { variant = 'contact', id = 'form' } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const f = d.form;
const action = variant === 'brief' ? '/api/brief.php' : '/api/contacto.php';
---
<form class="form" id={id} action={action} method="post" novalidate>
  <input type="hidden" name="lang" value={locale} />
  <input type="hidden" name="source" value={variant} />
  <p class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></p>

  <div class="field half"><label class="field__label" for={`${id}-name`}>{f.name} <abbr title={f.required}>*</abbr></label><input id={`${id}-name`} name="name" type="text" required autocomplete="name" /></div>
  <div class="field half"><label class="field__label" for={`${id}-company`}>{f.company}</label><input id={`${id}-company`} name="company" type="text" autocomplete="organization" /></div>
  <div class="field half"><label class="field__label" for={`${id}-email`}>{f.email} <abbr title={f.required}>*</abbr></label><input id={`${id}-email`} name="email" type="email" required autocomplete="email" /></div>
  <div class="field half"><label class="field__label" for={`${id}-phone`}>{f.phone}</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" /></div>

  {variant === 'brief' && (
    <>
      <div class="field half"><label class="field__label" for={`${id}-date`}>{f.date}</label><input id={`${id}-date`} name="date" type="date" /></div>
      <div class="field half"><label class="field__label" for={`${id}-city`}>{f.city}</label><input id={`${id}-city`} name="city" type="text" autocomplete="address-level2" /></div>
      <div class="field half">
        <label class="field__label" for={`${id}-type`}>{f.type}</label>
        <select id={`${id}-type`} name="type">
          <option value="">{f.selectPlaceholder}</option>
          {f.typeOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="field half"><label class="field__label" for={`${id}-deadline`}>{f.deadline}</label><input id={`${id}-deadline`} name="deadline" type="text" /></div>
      <fieldset class="field">
        <legend class="field__label">{f.deliverables}</legend>
        <div class="checks">
          {f.deliverableOptions.map((o) => <label><input type="checkbox" name="deliverables[]" value={o} />{o}</label>)}
        </div>
      </fieldset>
    </>
  )}

  <div class="field"><label class="field__label" for={`${id}-message`}>{f.message}</label><textarea id={`${id}-message`} name="message"></textarea></div>

  <label class="consent"><input type="checkbox" name="consent" required /> <span>{f.consent} <a href={path('privacy', locale)}>{d.footer.privacy}</a>.</span></label>

  <div class="form__actions">
    <button class="btn label" type="submit">{variant === 'brief' ? f.sendBrief : f.send}</button>
    <span class="form__note">* {f.required}. {f.pending}</span>
  </div>
</form>

<style>
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { padding: 0; margin-bottom: 0.5rem; }
  .form__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
</style>
