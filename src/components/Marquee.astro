---
/** Banda de marcas. Marquee animado en escritorio; lista estática en móvil y con reduced-motion. */
import { resolveLocale, dict } from '../i18n';
import clientes from '../data/clientes.json';
const d = dict(resolveLocale(Astro.currentLocale));
const list = clientes.filter((c) => c.marquee);
---
<section class="marquee rule-top rule-bottom" aria-label={d.marquee.label}>
  <ul class="marquee-track display" role="list">
    {list.map((c) => <li>{c.name}</li>)}
    {list.map((c) => <li aria-hidden="true" class="marquee__dup">{c.name}</li>)}
  </ul>
</section>

<style>
  .marquee { margin-top: 1.75rem; padding-block: 1rem; overflow: hidden; }
  .marquee-track { font-size: var(--fs-marquee); line-height: 1; }
  /* Móvil: sin animación, lista que envuelve */
  @media (max-width: 899px) {
    .marquee-track { animation: none; width: auto; flex-wrap: wrap; gap: 0.625rem 1.375rem; padding-inline: var(--gutter); }
    .marquee__dup { display: none; }
  }
  @media (min-width: 900px) {
    .marquee { margin-top: 2.5rem; padding-block: 1.25rem; }
    .marquee-track li { padding-right: 4rem; }
    .marquee-track { gap: 0; }
    .marquee:hover .marquee-track { animation-play-state: paused; }
  }
</style>
