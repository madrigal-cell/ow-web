---
/**
 * Trabajos de la home, opción A: lista tipo blog.
 * Una entrada por fila, todas del mismo tamaño. El orden lo marca `order` en cada caso:
 * el primero es el más importante y se baja haciendo scroll.
 */
import { Image } from 'astro:assets';
import { resolveLocale, dict, useTranslations, path, casePath } from '../i18n';
import { featuredCases, type Caso } from '../lib/casos';

const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const t = useTranslations(locale);
const { all, featured } = await featuredCases(locale);
const types = d.types as Record<string, string>;
const meta = (c: Caso) => [types[c.data.type], c.data.year, c.data.duration].filter(Boolean).join(' · ');
---
<section class="work" aria-labelledby="work-title">
  <div class="work__head wrap">
    <h2 id="work-title" class="display work__title">{d.work.title}</h2>
    <a class="label link-rule" href={path('work', locale)}>
      <span class="work__all">{t('work.seeAll', { n: all.length })}</span>
      <span class="work__all-short">{t('work.seeAllShort', { n: all.length })}</span>
    </a>
  </div>

  <ol class="work__list" role="list">
    {featured.map((c) => (
      <li class="entry">
        <a class="entry__link wrap grid-12" href={casePath(c.data.slug, locale)}>
          <div class:list={['entry__cover', `entry__cover--${c.data.coverTone}`]}>
            {c.data.cover && (
              <Image src={c.data.cover} alt={c.data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 900px) 46vw, 100vw" loading="lazy" />
            )}
          </div>
          <div class="entry__text">
            <p class="label entry__meta">{meta(c)}</p>
            <h3 class="display entry__title">{c.data.title}</h3>
            <p class="entry__lead muted">{c.data.lead}</p>
            <span class="label entry__more">{d.work.read}</span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .work { padding-top: var(--section-y); }
  .work__head { display: flex; justify-content: space-between; align-items: end; padding-bottom: 1rem; }
  .work__title { font-size: var(--fs-section); line-height: 0.9; }
  .work__all { display: none; }

  .entry { border-top: var(--line) solid var(--color-ink); }
  .entry:last-child { border-bottom: var(--line) solid var(--color-ink); }
  .entry__link { padding-block: 1.5rem; row-gap: 1rem; align-items: start; }
  .entry__cover, .entry__text { grid-column: 1 / -1; }
  .entry__cover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; }
  .entry__cover--accent { background: var(--color-accent); }
  .entry__cover--ink { background: var(--color-ink); }
  .entry__cover--paper { background: var(--color-placeholder); }
  .entry__cover :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  .entry__link:hover .entry__cover :global(img) { transform: scale(1.03); }
  .entry__text { display: flex; flex-direction: column; gap: 0.625rem; }
  .entry__meta { color: var(--color-label); }
  .entry__title { font-size: var(--fs-card); line-height: 1; transition: color var(--dur) var(--ease); }
  .entry__link:hover .entry__title { color: var(--color-accent); }
  .entry__lead { font-size: var(--fs-body); line-height: 1.45; max-width: 52ch; }
  .entry__more { color: var(--color-accent-ink); margin-top: 0.125rem; }

  @media (min-width: 900px) {
    .work__head { padding-bottom: 1.5rem; }
    .work__all { display: inline; }
    .work__all-short { display: none; }
    .entry__link { padding-block: 2.25rem; align-items: center; }
    .entry__cover { grid-column: 1 / span 5; }
    .entry__text { grid-column: 7 / span 6; gap: 0.75rem; }
  }
</style>
