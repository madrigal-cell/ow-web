---
/**
 * Trabajos de la home, opción B: índice.
 * Filas iguales, sin jerarquía: número, título, tipo y año, con la portada en
 * miniatura a la derecha (escritorio). Al pasar el ratón la fila se pone en negro.
 */
import { Image } from 'astro:assets';
import { resolveLocale, dict, useTranslations, path, casePath } from '../i18n';
import { featuredCases, type Caso } from '../lib/casos';

const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const t = useTranslations(locale);
const { all, featured } = await featuredCases(locale);
const types = d.types as Record<string, string>;
const meta = (c: Caso) => [types[c.data.type], c.data.year].filter(Boolean).join(' · ');
---
<section class="work" aria-labelledby="work-title">
  <div class="work__head wrap">
    <h2 id="work-title" class="display work__title">{d.work.title}</h2>
    <a class="label link-rule" href={path('work', locale)}>
      <span class="work__all">{t('work.seeAll', { n: all.length })}</span>
      <span class="work__all-short">{t('work.seeAllShort', { n: all.length })}</span>
    </a>
  </div>

  <ol class="index" role="list">
    {featured.map((c, i) => (
      <li class="row">
        <a class="row__link wrap" href={casePath(c.data.slug, locale)}>
          <span class="label row__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="display row__title">{c.data.title}</span>
          <span class="label row__meta">{meta(c)}</span>
          <span class:list={['row__thumb', `row__thumb--${c.data.coverTone}`]}>
            {c.data.cover && (
              <Image src={c.data.cover} alt={c.data.coverAlt ?? ''} widths={[320, 480]} sizes="200px" loading="lazy" />
            )}
          </span>
          <svg class="row__arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h13M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" />
          </svg>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .work { padding-top: var(--section-y); }
  .work__head { display: flex; justify-content: space-between; align-items: end; padding-bottom: 1rem; }
  .work__title { font-size: var(--fs-section); line-height: 0.9; }
  .work__all { display: none; }

  .row { border-top: var(--line) solid var(--color-ink); }
  .row:last-child { border-bottom: var(--line) solid var(--color-ink); }
  .row__link {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    grid-template-areas: 'num title arrow' '. meta meta';
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.375rem;
    padding-block: 1.125rem;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .row__num { grid-area: num; color: var(--color-accent-ink); }
  .row__title { grid-area: title; font-size: var(--fs-card-sm); line-height: 1; }
  .row__meta { grid-area: meta; color: var(--color-label); }
  .row__arrow { grid-area: arrow; flex: none; transition: transform var(--dur) var(--ease); }
  .row__thumb { display: none; }

  @media (min-width: 900px) {
    .work__head { padding-bottom: 1.5rem; }
    .work__all { display: inline; }
    .work__all-short { display: none; }
    .row__link {
      grid-template-columns: 3.5rem minmax(0, 1fr) 11rem 200px 2rem;
      grid-template-areas: 'num title meta thumb arrow';
      column-gap: var(--gap);
      row-gap: 0;
      padding-block: 0.875rem;
    }
    .row__title { font-size: var(--fs-row); }
    .row__thumb { display: block; position: relative; aspect-ratio: 16 / 9; overflow: hidden; }
    .row__thumb--accent { background: var(--color-accent); }
    .row__thumb--ink { background: var(--color-ink); }
    .row__thumb--paper { background: var(--color-placeholder); }
    .row__thumb :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: filter var(--dur) var(--ease); }
    .row__link:hover { background: var(--color-ink); color: var(--color-bg); }
    .row__link:hover .row__num { color: var(--color-accent); }
    .row__link:hover .row__meta { color: var(--color-text-dark); }
    .row__link:hover .row__thumb :global(img) { filter: none; }
    .row__link:hover .row__arrow { transform: translateX(4px); }
  }
</style>
