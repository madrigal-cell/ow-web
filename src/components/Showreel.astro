---
/**
 * Showreel de la home. Sin vídeo aún: póster negro rayado con el mensaje.
 * Con `site.showreel.vimeoId`: el botón carga el reproductor de Vimeo bajo demanda
 * (nada se descarga hasta que el usuario pulsa play: Core Web Vitals intactos).
 */
import { Image } from 'astro:assets';
import { resolveLocale, dict, useTranslations } from '../i18n';
import { site } from '../data/site';
const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const t = useTranslations(locale);
const { vimeoId, year, duration, poster, title } = site.showreel;
const rec = t('showreel.rec', { year, duration });
---
<section class="reel wrap" aria-label="Showreel">
  <div class:list={['reel__frame', { 'reel__frame--poster': !!(vimeoId && poster) }]} data-vimeo-id={vimeoId ?? undefined}>
    <div class="reel__stripes" aria-hidden="true"></div>
    {vimeoId && poster && <Image class="reel__poster" src={poster} alt={title} widths={[640, 1024, 1600]} sizes="(min-width: 1600px) 1500px, 100vw" loading="eager" fetchpriority="high" />}
    <p class="label reel__rec"><span class="reel__dot" aria-hidden="true"></span>{rec}</p>
    <div class="reel__cta">
      <button class="reel__play" type="button" aria-label={d.showreel.play} disabled={!vimeoId}>
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 4.5v15l12-7.5-12-7.5z" fill="currentColor"/></svg>
      </button>
      <p class="display reel__title">{d.showreel.title}</p>
    </div>
    {!vimeoId && <p class="reel__note">{d.showreel.pending}</p>}
    <div class="reel__player" hidden></div>
  </div>
</section>

<style>
  .reel__frame { position: relative; background: var(--color-ink); color: var(--color-bg); aspect-ratio: 350 / 420; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
  .reel__stripes { position: absolute; inset: 0; background: repeating-linear-gradient(135deg, var(--color-ink) 0 28px, var(--color-stripe-dark) 28px 56px); }
  .reel__rec { position: relative; display: flex; align-items: center; gap: 0.625rem; }
  .reel__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--color-accent); animation: blink 1.6s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .reel__cta { position: relative; display: flex; flex-direction: column; gap: 1rem; }
  .reel__play { width: 72px; height: 72px; background: var(--color-accent); color: var(--color-ink); display: grid; place-items: center; flex: none; transition: transform var(--dur) var(--ease), background var(--dur) var(--ease); }
  .reel__play svg { width: 30px; height: 30px; }
  .reel__play:not(:disabled):hover { background: var(--color-bg); transform: scale(1.04); }
  .reel__play:disabled { cursor: default; }
  .reel__title { font-size: var(--fs-h2); line-height: 0.95; white-space: pre-line; }
  .reel__note { display: none; }
  .reel :global(.reel__poster) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .reel__frame--poster::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(11, 11, 11, 0.75), rgba(11, 11, 11, 0.15) 55%, rgba(11, 11, 11, 0.35)); pointer-events: none; }
  .reel__frame--poster .reel__rec, .reel__frame--poster .reel__cta { z-index: 1; }
  .reel__player { position: absolute; inset: 0; background: #000; }
  .reel__player :global(iframe) { width: 100%; height: 100%; border: 0; }

  @media (min-width: 900px) {
    .reel__frame { aspect-ratio: 1344 / 620; padding: 2rem; flex-direction: row; align-items: flex-end; }
    .reel__stripes { background: repeating-linear-gradient(135deg, var(--color-ink) 0 40px, var(--color-stripe-dark) 40px 80px); }
    .reel__rec { position: absolute; left: 2rem; top: 2rem; gap: 0.75rem; }
    .reel__dot { width: 12px; height: 12px; }
    .reel__cta { flex-direction: row; align-items: center; gap: 1.5rem; }
    .reel__play { width: 120px; height: 120px; }
    .reel__play svg { width: 44px; height: 44px; }
    .reel__note { display: block; position: relative; color: var(--color-muted-dark); font-size: var(--fs-small); max-width: 20rem; line-height: 1.4; text-align: right; }
  }
  @media (prefers-reduced-motion: reduce) { .reel__dot { animation: none; } }
</style>

<script>
  const frame = document.querySelector<HTMLElement>('.reel__frame');
  const id = frame?.dataset.vimeoId;
  const btn = frame?.querySelector<HTMLButtonElement>('.reel__play');
  const player = frame?.querySelector<HTMLElement>('.reel__player');
  if (frame && id && btn && player) {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://player.vimeo.com/video/${id}?autoplay=1&title=0&byline=0&portrait=0&dnt=1`;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.title = btn.getAttribute('aria-label') ?? 'Showreel';
      player.replaceChildren(iframe);
      player.hidden = false;
      frame.querySelectorAll<HTMLElement>('.reel__rec, .reel__cta, .reel__note').forEach((el) => (el.hidden = true));
    }, { once: true });
  }
</script>
