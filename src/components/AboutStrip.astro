---
/** Franja "Nosotros" de la home, con el párrafo factual sobre la empresa. */
import { resolveLocale, dict, path } from '../i18n';
const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
---
<section class="about wrap grid-12" aria-labelledby="about-title">
  <h2 id="about-title" class="display about__title">{d.about.title}</h2>
  <div class="about__body">
    <p>{d.about.p1}</p>
    <p>{d.about.p2}</p>
    <a class="label link-rule about__link" href={path('about', locale)}>{d.about.link}</a>
  </div>
</section>

<style>
  .about { padding-block: var(--section-y); row-gap: 1.125rem; align-items: start; }
  .about__title, .about__body { grid-column: 1 / -1; }
  .about__title { font-size: var(--fs-h3); line-height: 0.95; }
  .about__body { display: flex; flex-direction: column; gap: 1rem; font-size: var(--fs-lead); line-height: 1.45; }
  .about__link { align-self: flex-start; }

  @media (min-width: 900px) {
    .about__title { grid-column: 1 / span 5; white-space: pre-line; }
    .about__body { grid-column: 7 / span 6; font-weight: 400; }
  }
</style>
