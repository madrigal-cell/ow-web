---
/** Cabecera: logotipo textual, enlaces, CTA y selector de idioma. En móvil, menú desplegable. */
import { resolveLocale, dict, path, alternatePath, type Locale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const other: Locale = locale === 'es' ? 'en' : 'es';
const d = dict(locale);
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const altHref = alternatePath(current, locale, other);

const links = [
  { href: path('work', locale), label: d.nav.work },
  { href: path('services', locale), label: d.nav.services },
  { href: path('agencies', locale), label: d.nav.agencies },
  { href: path('about', locale), label: d.nav.about },
];
const isCurrent = (href: string) => (current === href || (href !== '/' && href !== '/en/' && current.startsWith(href)) ? 'page' : undefined);
---

<header class="nav rule-bottom">
  <div class="nav__bar wrap">
    <a class="display nav__logo" href={path('home', locale)}>On White</a>

    <nav class="nav__desktop label" aria-label={d.nav.menu}>
      {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href)}>{l.label}</a>)}
      <a class="btn btn--sm" href={path('contact', locale)}>{d.nav.cta}</a>
      <a class="nav__lang" href={altHref} hreflang={other} lang={other} aria-label={`${locale.toUpperCase()} / ${other.toUpperCase()} · ${d.nav.switchLang}`}>
        <span class="nav__lang-on">{locale.toUpperCase()}</span> / <span>{other.toUpperCase()}</span>
      </a>
    </nav>

    <div class="nav__mobile">
      <a class="label nav__lang" href={altHref} hreflang={other} lang={other} aria-label={`${locale.toUpperCase()} / ${other.toUpperCase()} · ${d.nav.switchLang}`}>
        <span class="nav__lang-on">{locale.toUpperCase()}</span> / <span>{other.toUpperCase()}</span>
      </a>
      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label={d.nav.openMenu} data-open={d.nav.openMenu} data-close={d.nav.closeMenu}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="nav-menu" class="nav__menu on-dark" hidden aria-label={d.nav.menu}>
    <div class="wrap nav__menu-inner">
      {links.map((l) => <a class="display" href={l.href} aria-current={isCurrent(l.href)}>{l.label}</a>)}
      <a class="btn btn--accent label nav__menu-cta" href={path('contact', locale)}>{d.nav.cta}</a>
    </div>
  </nav>
</header>

<style>
  .nav { background: var(--color-bg); position: relative; z-index: 20; }
  .nav__bar { display: flex; justify-content: space-between; align-items: center; padding-block: 1.125rem; }
  .nav__logo { font-size: 1.375rem; line-height: 1; }
  .nav__desktop { display: none; align-items: center; gap: 2.25rem; }
  .nav__desktop a[aria-current='page']:not(.btn) { border-bottom: var(--line) solid var(--color-accent); padding-bottom: 0.25rem; }
  .nav__lang { color: var(--color-label); white-space: nowrap; }
  .nav__lang-on { color: var(--color-ink); }
  .nav__mobile { display: flex; align-items: center; gap: 0.875rem; }
  .nav__burger { width: 44px; height: 44px; display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: 6px; }
  .nav__burger span { display: block; height: 3px; background: var(--color-ink); width: 28px; transition: transform var(--dur) var(--ease), width var(--dur) var(--ease); }
  .nav__burger span:last-child { width: 20px; }
  .nav__burger[aria-expanded='true'] span:first-child { transform: translateY(4.5px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] span:last-child { width: 28px; transform: translateY(-4.5px) rotate(-45deg); }
  .nav__menu { position: absolute; left: 0; right: 0; top: 100%; border-top: var(--line) solid var(--color-ink); }
  .nav__menu-inner { display: flex; flex-direction: column; gap: 1rem; padding-block: 1.75rem 2rem; }
  .nav__menu a.display { font-size: var(--fs-h2); line-height: 0.95; }
  .nav__menu a.display[aria-current='page'] { color: var(--color-accent); }
  .nav__menu-cta { margin-top: 0.75rem; height: 56px; }

  @media (min-width: 900px) {
    .nav__bar { padding-block: 1.75rem; }
    .nav__logo { font-size: 1.75rem; }
    .nav__desktop { display: flex; }
    .nav__mobile, .nav__menu { display: none; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav__burger');
  const menu = document.getElementById('nav-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? btn.dataset.close! : btn.dataset.open!);
      menu.hidden = !open;
    };
    btn.addEventListener('click', () => set(menu.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
  }
</script>
