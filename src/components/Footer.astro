---
/** Pie: "Dale al play." en acento, contacto, redes y legal. */
import { resolveLocale, dict, path } from '../i18n';
import { site } from '../data/site';
const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const gaId = import.meta.env.PUBLIC_GA4_ID as string | undefined;
---
<footer class="footer rule-top">
  <div class="footer__inner wrap">
    <p class="display footer__play">{d.footer.play}</p>
    <div class="footer__info">
      <p><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.phone.href}>{d.footer.phone}</a></p>
      <p>{d.footer.address}</p>
      <p><a href={site.social.linkedin} rel="noopener" target="_blank">LinkedIn</a>{' · '}<a href={site.social.instagram} rel="noopener" target="_blank">Instagram</a>{' · '}<a href={site.social.vimeo} rel="noopener" target="_blank">Vimeo</a></p>
      <p class="footer__legal">{site.legalName}{' · '}<a href={path('legal', locale)}>{d.footer.legal}</a>{' · '}<a href={path('privacy', locale)}>{d.footer.privacy}</a>{' · '}<a href={path('cookies', locale)}>{d.footer.cookies}</a>{gaId && <>{' · '}<a href="#" class="js-cookie-settings">{d.cookies.settings}</a></>}</p>
    </div>
  </div>
</footer>

<style>
  .footer__inner { display: flex; flex-direction: column; gap: 1.125rem; padding-block: 1.5rem 2rem; }
  .footer__play { font-size: var(--fs-section); line-height: 0.85; color: var(--color-accent); }
  .footer__info { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.8125rem; color: var(--color-muted); }
  .footer__info a:hover { color: var(--color-accent); }
  .footer__legal { margin-top: 0.5rem; }

  @media (min-width: 900px) {
    .footer__inner { flex-direction: row; justify-content: space-between; align-items: end; padding-block: 2rem 2.5rem; }
    .footer__info { gap: 0.375rem; font-size: var(--fs-small); text-align: right; }
    .footer__legal { margin-top: 0.625rem; }
  }
</style>
