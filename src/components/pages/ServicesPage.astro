---
/** Índice de servicios: tres bloques numerados con enlace a cada página. */
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import PageHead from '../PageHead.astro';
import CtaBand from '../CtaBand.astro';
import { resolveLocale, dict, servicePath } from '../../i18n';

const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const services = (await getCollection('servicios', ({ data }) => data.lang === locale)).sort((a, b) => a.data.order - b.data.order);
const title = `${d.servicesPage.kicker} · ${d.meta.siteName}`;
---
<Page title={title} description={d.servicesPage.lead}>
  <PageHead kicker={d.servicesPage.kicker} title={d.servicesPage.title} lead={d.servicesPage.lead} />

  <ol class="services wrap" role="list">
    {services.map((s, i) => (
      <li class="service grid-12">
        <span class="display service__num accent">0{i + 1}</span>
        <div class="service__main">
          <h2 class="display service__title"><a href={servicePath(s.data.key, locale)}>{s.data.title}</a></h2>
          <p class="lead">{s.data.lead}</p>
        </div>
        <div class="service__aside">
          <ul class="service__items" role="list">{s.data.items.map((x) => <li>{x}</li>)}</ul>
          <a class="label link-rule" href={servicePath(s.data.key, locale)}>{d.servicesPage.see}</a>
        </div>
      </li>
    ))}
  </ol>

  <CtaBand />
</Page>

<style>
  .service { padding-block: 2rem; border-top: var(--line) solid var(--color-ink); row-gap: 1.25rem; align-items: start; }
  .services li:last-child { border-bottom: var(--line) solid var(--color-ink); }
  .service__num { grid-column: 1 / -1; font-size: var(--fs-row); line-height: 1; }
  .service__main { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 1rem; }
  .service__title { font-size: var(--fs-block); line-height: 0.9; }
  .service__title a:hover { color: var(--color-accent); }
  .service__aside { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  .service__items { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .service__items li { font-size: var(--fs-small); font-weight: 500; padding: 0.5rem 0.75rem; border: var(--line-thin) solid var(--color-ink); }
  @media (min-width: 900px) {
    .service { padding-block: 3rem; }
    .service__num { grid-column: 1 / span 1; }
    .service__main { grid-column: 2 / span 6; }
    .service__aside { grid-column: 9 / span 4; padding-top: 0.5rem; }
  }
</style>
