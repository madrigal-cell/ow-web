---
/** Ficha de un caso: vídeo embebido, datos, reto/qué hicimos/resultado, galería y siguiente caso. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Page from '../../layouts/Page.astro';
import PageHead from '../PageHead.astro';
import VimeoEmbed from '../VimeoEmbed.astro';
import CtaBand from '../CtaBand.astro';
import { resolveLocale, dict, casePath, path } from '../../i18n';

interface Props { entry: CollectionEntry<'casos'> }
const { entry } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const types = d.types as Record<string, string>;
const { Content } = await render(entry);
const c = entry.data;

const all = (await getCollection('casos', ({ data }) => data.lang === locale)).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.data.slug === c.slug);
const next = all[(idx + 1) % all.length];
const kicker = [types[c.type], c.client, c.agency].filter(Boolean).join(' · ');
const title = `${c.title} · ${d.meta.siteName}`;
const facts = [
  [d.casePage.client, c.client],
  [d.casePage.agency, c.agency],
  [d.casePage.type, types[c.type]],
  [d.casePage.year, c.year],
  [d.casePage.duration, c.duration],
].filter(([, v]) => v);
---
<Page title={title} description={c.lead} ogType="article">
  <PageHead kicker={kicker} title={c.title} lead={c.lead} size="block">
    {c.pending && <p class="pending-note page-head__note">{d.casePage.pending}</p>}
  </PageHead>

  <div class="wrap">
    <VimeoEmbed vimeoId={c.vimeoId} title={c.title} tone={c.coverTone} label={c.duration} />
  </div>

  <section class="case-body wrap grid-12">
    <aside class="case-facts">
      <dl>
        {facts.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
        {c.deliverables.length > 0 && (
          <div><dt class="label">{d.casePage.deliverables}</dt><dd><ul role="list">{c.deliverables.map((x) => <li>{x}</li>)}</ul></dd></div>
        )}
      </dl>
    </aside>
    <div class="prose case-prose"><Content /></div>
  </section>

  {c.gallery.length > 0 && (
    <section class="gallery wrap" aria-label={d.casePage.gallery}>
      {c.gallery.map((img, i) => <Image src={img} alt={`${c.title} · ${i + 1}`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" />)}
    </section>
  )}

  <nav class="case-nav wrap" aria-label={d.casePage.next}>
    <a class="label link-rule" href={path('work', locale)}>{d.casePage.back}</a>
    {next && next.data.slug !== c.slug && (
      <a class="case-nav__next" href={casePath(next.data.slug, locale)}>
        <span class="label">{d.casePage.next}</span>
        <span class="display">{next.data.title} →</span>
      </a>
    )}
  </nav>

  <CtaBand />
</Page>

<style>
  .page-head__note { grid-column: 1 / -1; }
  .case-body { padding-block: var(--section-y); row-gap: 2rem; align-items: start; }
  .case-facts { grid-column: 1 / -1; }
  .case-facts dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem var(--gap); }
  .case-facts dt { color: var(--color-label); margin-bottom: 0.25rem; }
  .case-facts dd { margin: 0; font-size: var(--fs-lead); line-height: 1.3; }
  .case-facts ul { padding: 0; }
  .case-prose { grid-column: 1 / -1; }
  .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  .gallery :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 3 / 2; }
  .case-nav { margin-top: var(--section-y); display: flex; flex-direction: column; gap: 2rem; align-items: flex-start; }
  .case-nav__next { display: flex; flex-direction: column; gap: 0.5rem; }
  .case-nav__next .display { font-size: var(--fs-h2); line-height: 0.95; transition: color var(--dur) var(--ease); }
  .case-nav__next:hover .display { color: var(--color-accent); }
  @media (min-width: 900px) {
    .case-facts { grid-column: 1 / span 4; position: sticky; top: 2rem; }
    .case-facts dl { grid-template-columns: 1fr; gap: 1.25rem; }
    .case-prose { grid-column: 6 / span 7; }
    .case-nav { flex-direction: row; justify-content: space-between; align-items: end; }
    .case-nav__next { text-align: right; }
  }
</style>
