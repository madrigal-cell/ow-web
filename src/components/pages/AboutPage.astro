---
/** Nosotros: párrafo factual, fundadores, equipo, plató, equipo técnico y dónde operamos. */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Page from '../../layouts/Page.astro';
import PageHead from '../PageHead.astro';
import CtaBand from '../CtaBand.astro';
import { resolveLocale, dict } from '../../i18n';

const locale = resolveLocale(Astro.currentLocale);
const d = dict(locale);
const a = d.aboutPage;
const team = (await getCollection('equipo')).sort((x, y) => x.data.order - y.data.order);
const founders = team.filter((p) => p.data.founder);
const rest = team.filter((p) => !p.data.founder);
const anyPending = team.some((p) => p.data.pending);
const title = `${a.kicker} · ${d.meta.siteName}`;
---
<Page title={title} description={a.geo}>
  <PageHead kicker={a.kicker} title={d.about.title} size="block" preLine />

  <section class="wrap grid-12 geo">
    <p class="lead geo__text">{a.geo}</p>
  </section>

  <section class="section wrap">
    <h2 class="section__title">{a.founders}</h2>
    <div class="grid-12 people people--founders">
      {founders.map((p) => (
        <article class="person">
          <div class="person__photo person__photo--ink">{p.data.photo ? <Image src={p.data.photo} alt={p.data.name} widths={[400, 800]} sizes="(min-width: 900px) 40vw, 100vw" loading="lazy" /> : <span class="label">{a.photoPending}</span>}</div>
          <h3 class="display person__name">{p.data.name}</h3>
          <p class="muted">{p.data.role[locale]}</p>
        </article>
      ))}
    </div>
  </section>

  {rest.length > 0 && (
    <section class="section wrap">
      <h2 class="section__title">{a.team}</h2>
      <div class="grid-12 people">
        {rest.map((p) => (
          <article class="person">
            <div class="person__photo person__photo--paper">{p.data.photo ? <Image src={p.data.photo} alt={p.data.name} widths={[300, 600]} sizes="(min-width: 900px) 25vw, 50vw" loading="lazy" /> : <span class="label">{a.photoPending}</span>}</div>
            <h3 class="display person__name person__name--sm">{p.data.name}</h3>
            <p class="muted">{p.data.role[locale]}</p>
          </article>
        ))}
      </div>
      {anyPending && <p class="pending-note" style="margin-top: 1.5rem">{a.pending}</p>}
    </section>
  )}

  <section class="section wrap grid-12 studio">
    <div class="studio__visual" aria-hidden="true"></div>
    <div class="studio__text">
      <h2 class="display studio__title">{a.studioTitle}</h2>
      <p class="lead">{a.studio}</p>
      <h3 class="label studio__sub">{a.gearTitle}</h3>
      <ul class="studio__gear" role="list">{a.gear.map((g) => <li>{g}</li>)}</ul>
      <h3 class="label studio__sub">{a.whereTitle}</h3>
      <p>{a.where}</p>
    </div>
  </section>

  <CtaBand />
</Page>

<style>
  .geo { padding-block: 0.5rem 1rem; }
  .geo__text { grid-column: 1 / -1; max-width: 70ch; font-weight: 400; }
  .people { row-gap: 2rem; }
  .people > :global(*) { grid-column: span 6; }
  .person { display: flex; flex-direction: column; gap: 0.5rem; }
  .person__photo { aspect-ratio: 4 / 5; display: flex; align-items: flex-end; padding: 1rem; overflow: hidden; position: relative; }
  .person__photo--ink { background: var(--color-ink); color: var(--color-text-dark); }
  .person__photo--paper { background: var(--color-placeholder); color: var(--color-label); }
  .person__photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .person__name { font-size: var(--fs-card); line-height: 1; margin-top: 0.25rem; }
  .person__name--sm { font-size: var(--fs-card-sm); }
  .studio { row-gap: 2rem; align-items: start; }
  .studio__visual { grid-column: 1 / -1; aspect-ratio: 16 / 10; background: var(--color-accent); }
  .studio__text { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 1rem; }
  .studio__title { font-size: var(--fs-block); line-height: 0.9; }
  .studio__sub { color: var(--color-label); margin-top: 1rem; }
  .studio__gear li { padding-block: 0.625rem; border-top: var(--line-thin) solid var(--color-ink); font-size: var(--fs-lead); }
  .studio__gear li:last-child { border-bottom: var(--line-thin) solid var(--color-ink); }
  @media (min-width: 900px) {
    .people--founders > :global(*) { grid-column: span 5; }
    .people:not(.people--founders) > :global(*) { grid-column: span 3; }
    .studio__visual { grid-column: 1 / span 6; }
    .studio__text { grid-column: 8 / span 5; }
  }
</style>
