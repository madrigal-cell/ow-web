# owmakers.com · On White
# Se copia tal cual a la raíz del hosting (IONOS, Apache).

AddDefaultCharset UTF-8
Options -Indexes -MultiViews
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Siempre https y sin www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2) Redirecciones desde la web antigua (WordPress)
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|s)= [NC]
  RewriteRule ^$ /? [R=301,L]
  RewriteRule ^(inicio|home|index\.php)/?$ / [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|wp-json|xmlrpc\.php|feed|comments|author|category|tag)(/.*)?$ / [R=301,L]

  # 3) Barra final en directorios reales (Astro genera /ruta/index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # 4) Quitar /index.html de la URL
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché: los ficheros de /_astro/ llevan hash en el nombre y pueden cachearse un año.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2)$">
    Header setifempty Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Nadie debe llamar directamente al fichero compartido de correo
<Files "_mail.php">
  Require all denied
</Files>
