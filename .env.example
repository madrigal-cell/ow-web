# Copia este fichero a .env y rellena los datos. .env NUNCA se sube al repositorio.

# Despliegue a IONOS por SSH/rsync (paso 5).
# DEPLOY_HOST: alias definido en ~/.ssh/config (con su clave) o usuario@servidor.
DEPLOY_HOST=home585926058.1and1-data.host
# Carpeta remota donde vive la web (ruta absoluta en el servidor).
DEPLOY_DIR=/homepages/41/d585926058/htdocs/owmakers-web
# Dirección pública para comprobar tras publicar (opcional).
DEPLOY_URL=https://nueva.owmakers.com

# Analítica (GA4). Vacío = sin analítica ni aviso de cookies. Ej.: G-XXXXXXXXXX
PUBLIC_GA4_ID=
