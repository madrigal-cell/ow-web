# Copia este fichero a .env y rellena los datos. .env NUNCA se sube al repositorio.
# Despliegue a IONOS por SFTP (paso 5 del handoff).
IONOS_SFTP_HOST=
IONOS_SFTP_USER=
IONOS_SFTP_PORT=22
IONOS_SFTP_KEY=~/.ssh/id_ed25519
IONOS_REMOTE_DIR=/
# Analítica (GA4). Se carga solo tras aceptar cookies.
PUBLIC_GA4_ID=
